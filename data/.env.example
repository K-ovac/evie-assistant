LM_MODEL=   # local-modelили точный id  api модели из LM Studio Server
LM_STUDIO_URL= # URL LM Studio Server, если используется локальная модель.

# Email Config
EMAIL_IMAP_HOST=   # например
EMAIL_USER=
EMAIL_PASSWORD=  # пароль приложения, не основной

# Telegram Bot Config
TG_BOT_TOKEN=  #TG Bot Token from @BotFather
TG_ALLOWED_IDS= #TG Allowed User IDs, разделённые запятой, например "123456789,987654321"
TG_PROXY=   # TG Proxy, например "socks5://127.0.1:1080", если Telegram недоступен

# Assistant Config
AI_NAME=             # имя ассистента

# Weather Config
DEFAULT_CITY=     # город по умолчанию для погоды, если не указан другой